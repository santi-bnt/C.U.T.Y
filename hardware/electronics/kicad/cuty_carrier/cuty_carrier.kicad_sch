  (text "ALIMENTACION: Bateria 3S -> J2 interruptor general -> F1 (10 A) -> J3 interruptor servos -> J4/J5 buck 6 V -> servos" (at 20 30 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid eaff794b-4c6d-52a5-b2dd-c282019a80fd))
  (text "                                                      -> F2 (5 A) -> J6 regulador 5.1 V / 5 A con salida USB-C a la Raspberry Pi 5" (at 20 35 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid a630c961-3497-5530-beba-a5c54e7b07bc))
