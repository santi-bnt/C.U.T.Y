GEMINI_API_KEY=your_key_here
# CUTY_AI_PROVIDER=gemini
# For the optional paid OpenAI provider:
# OPENAI_API_KEY=your_key_here
# CUTY_AUDIO_INPUT_DEVICE=
# CUTY_AUDIO_OUTPUT_DEVICE=
# CUTY_LOG_LEVEL=INFO
# CUTY_DEBUG=false
# CUTY_GEMINI_MODEL=gemini-3.8-live
# CUTY_GEMINI_VISION_MODEL=gemini-3.8-flash
# CUTY_GEMINI_VISION_TIMEOUT=45  # seconds, valid range 5-120
# Limit speech transcription to Spanish and English to avoid false language detection.
# CUTY_VOICE_LANGUAGES=es,en
# Vision follows the existing touchscreen FaceTracker; identity matching stays local.
# Install/configure an OpenCV-contrib SFace model on the Pi before enabling recognition.
# CUTY_SFACE_MODEL=/home/santi/.local/share/cuty/models/face_recognition_sface_2021dec.onnx
# CUTY_FACE_PROFILE_PATH=/home/santi/.local/share/cuty/face_profiles.json
# CUTY_FACE_MATCH_THRESHOLD=0.363  # OpenCV baseline only; calibrate on the actual robot
# CUTY_FACE_MATCH_MARGIN=0.04
# CUTY_FACE_MATCH_CALIBRATED=0     # keep 0 until validation establishes local thresholds
# CUTY_FACE_MIN_SIZE=48
# CUTY_FACE_MIN_CONFIDENCE=0.75
# CUTY_FACE_ENROLL_SAMPLES=5       # allowed: 3–8
# CUTY_REALTIME_MODEL=gpt-realtime-2.1
# Animated face on the touchscreen (voice -> face UDP link)
# CUTY_FACE_LINK=127.0.0.1:5005   # "off" disables, or the Pi's IP from a PC
# CUTY_LIPSYNC_DELAY=0.08          # raise if the mouth moves before the sound
# Menu / --hands-free: local speech boundaries (Gemini, no new packages)
# CUTY_VAD_THRESHOLD=350          # PCM16 RMS; increase for background noise
# CUTY_VAD_SILENCE=0.9            # seconds of silence that finish a turn
# Local Music Mode (touchscreen / --hands-free mode only). Put authorized files here.
# CUTY_MUSIC_DIR=/home/santi/Music/CUTY
# CUTY_MUSIC_VOLUME=70            # 0-100; local music only, not voice/TTS
