GEMINI_API_KEY=your_key_here
# CUTY_AI_PROVIDER=gemini
# For the optional paid OpenAI provider:
# OPENAI_API_KEY=your_key_here
# CUTY_AUDIO_INPUT_DEVICE=
# CUTY_AUDIO_OUTPUT_DEVICE=
# CUTY_LOG_LEVEL=INFO
# CUTY_DEBUG=false
# CUTY_GEMINI_MODEL=gemini-3.8-live
# CUTY_REALTIME_MODEL=gpt-realtime-2.1
# Animated face on the touchscreen (voice -> face UDP link)
# CUTY_FACE_LINK=127.0.0.1:5005   # "off" disables, or the Pi's IP from a PC
# CUTY_LIPSYNC_DELAY=0.08          # raise if the mouth moves before the sound
