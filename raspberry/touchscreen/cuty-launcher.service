[Unit]
Description=C.U.T.Y Touchscreen Launcher (WiFi, Terminal, Face)
Wants=NetworkManager.service
After=NetworkManager.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/santi/C.U.T.Y
Environment=PYTHONPATH=/home/santi
ExecStartPre=/usr/bin/python3 -u /home/santi/C.U.T.Y/raspberry/touchscreen/cuty_display.py --wait 60
ExecStart=/usr/bin/python3 -u /home/santi/C.U.T.Y/raspberry/touchscreen/cuty_launcher.py
Restart=on-failure
RestartSec=4
TimeoutStartSec=75

[Install]
WantedBy=multi-user.target
